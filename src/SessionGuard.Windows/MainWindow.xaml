<Window x:Class="SessionGuard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SessionGuard" Icon="Assets/app.ico" Height="780" Width="560"
        MinHeight="560" MinWidth="480"
        Background="#16181D" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E2128"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SessionGuard" Foreground="White" FontSize="21"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}"
                       Text="Local session vault"/>
        </StackPanel>

        <!-- Guard toggle -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Guard" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                 Fill="#E5484D" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Off"
                                   Foreground="#E5484D" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <TextBlock x:Name="ProxyStateText" Style="{StaticResource Label}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnToggle" Grid.Column="1" Content="Turn on"
                        Width="120" Height="38" Background="#3E63DD"
                        Click="BtnToggle_Click"/>
            </Grid>
        </Border>

        <!-- Presence -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Presence" Style="{StaticResource Label}"/>
                <TextBlock Text="Injection only happens inside a window you open with a Windows Hello gesture, and only for the browser process you pick."
                           Style="{StaticResource Label}" TextWrapping="Wrap"
                           Margin="0,4,0,10" FontSize="10" Foreground="#6B7280"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Check" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbPresenceMode" Grid.Column="1" Height="28"
                              VerticalContentAlignment="Center"
                              Background="#2A2E37" Foreground="#111111"
                              SelectionChanged="CmbPresenceMode_Changed"/>
                    <Button x:Name="BtnExportCa" Grid.Column="2" Content="Export CA"
                            Width="80" Height="28" Margin="8,0,0,0"
                            Background="#3A3F4B" Click="BtnExportCa_Click"
                            ToolTip="Save the root certificate to the Desktop, for browsers with their own certificate store"/>
                    <Button x:Name="BtnResetKey" Grid.Column="3" Content="Reset key"
                            Width="80" Height="28" Margin="8,0,0,0"
                            Background="#8B2C32" Click="BtnResetKey_Click"/>
                </Grid>
                <TextBlock x:Name="PresenceCaveat" Style="{StaticResource Label}"
                           TextWrapping="Wrap" Margin="0,0,0,10" FontSize="10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbBrowsers" Height="30" VerticalContentAlignment="Center"
                              IsEditable="True" Background="#2A2E37" Foreground="#111111"
                              ToolTip="Pick the browser, or type its process id"/>
                    <Button x:Name="BtnRefresh" Grid.Column="1" Content="Refresh"
                            Width="72" Height="30" Margin="8,0,0,0"
                            Background="#3A3F4B" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnUnlock" Grid.Column="2" Content="Unlock"
                            Width="86" Height="30" Margin="8,0,0,0"
                            Background="#30A46C" Click="BtnUnlock_Click"/>
                </Grid>
                <TextBlock x:Name="ScanText" Style="{StaticResource Label}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="LeaseText" Text="Locked"
                           Foreground="#F5A524" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Protected hosts -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Protected hosts" Style="{StaticResource Label}"/>
                <TextBlock Text="Only these are intercepted; everything else is an untouched tunnel. Comma separated."
                           Style="{StaticResource Label}" TextWrapping="Wrap"
                           Margin="0,4,0,8" FontSize="10" Foreground="#6B7280"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtHosts" Height="30" VerticalContentAlignment="Center"
                             Background="#2A2E37" Foreground="#E8EDF5" BorderThickness="0"
                             Padding="6,0"/>
                    <Button x:Name="BtnSaveHosts" Grid.Column="1" Content="Save"
                            Width="72" Height="30" Margin="8,0,0,0"
                            Background="#3A3F4B" Click="BtnSaveHosts_Click"/>
                </Grid>
                <TextBlock x:Name="HostsText" Style="{StaticResource Label}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="SkippedText" TextWrapping="Wrap" FontSize="11"
                           Margin="0,6,0,0" Foreground="#F5A524"/>
            </StackPanel>
        </Border>

        <!-- Vault -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Vault" Style="{StaticResource Label}"/>
                    <Button x:Name="BtnForget" Content="Forget all" Width="86" Height="26"
                            HorizontalAlignment="Right" Background="#8B2C32"
                            FontSize="11" Click="BtnForget_Click"/>
                </Grid>
                <TextBlock x:Name="VaultText" Text="empty" Foreground="#C3CAD6"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="LeftAloneText" TextWrapping="Wrap" FontSize="11"
                           Margin="0,8,0,0" Foreground="#F5A524"/>
                <TextBlock x:Name="SealerText" Style="{StaticResource Label}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Log" Style="{StaticResource Label}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkLogging" Content="Logging" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Foreground="#8B93A1" FontSize="11"
                                  ToolTip="Stops recording. Nothing else changes — the guard keeps working."
                                  Checked="ChkLogging_Changed"
                                  Unchecked="ChkLogging_Changed"/>
                        <Button x:Name="BtnClearLog" Content="Clear" Width="56" Height="26"
                                Background="#3A3F4B" FontSize="11" Margin="0,0,8,0"
                                Click="BtnClearLog_Click"/>
                        <Button x:Name="BtnSaveLog" Content="Save log" Width="80" Height="26"
                                Background="#3A3F4B"
                                FontSize="11" Click="BtnSaveLog_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="#7C8595" FontSize="10.5"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
